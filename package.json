{
  "name": "@ecsplico/anon",
  "version": "0.1.1",
  "type": "module",
  "description": "German clinical text anonymization: Stammdaten rules, regex, local ONNX NER, local LLM NER; reversible ledger; CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecsplico/anon.git"
  },
  "keywords": [
    "anonymization",
    "pseudonymization",
    "de-identification",
    "german",
    "clinical",
    "pii",
    "ner"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "anon": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "//scripts": "`prepare` rather than `prepack`, because npm runs `prepare` for a git dependency after it is cloned, so a package installed straight from GitHub arrives with `dist/` built.",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsdown",
    "prepare": "npm run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "commander": "^15.0.0",
    "ibantools": "^4.5.0",
    "libphonenumber-js": "^1.13.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "openmed": "^3.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3"
  }
}
